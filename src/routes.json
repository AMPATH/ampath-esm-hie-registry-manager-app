{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {},
  "pages": [
    {
      "component": "facilityRegistryRoot",
      "route": "hie/facilities",
      "online": true,
      "offline": false
    },
    {
      "component": "healthWorkerRegistryRoot",
      "route": "hie/health-workers",
      "online": true,
      "offline": false
    }
  ],
  "extensions": [
    {
      "component": "hieNavLink",
      "name": "hie-registry-nav",
      "privileges": ["O3 View HIE Facility Registry Details", "O3 View HIE Health Worker Registry Details"],
      "slot": "app-menu-slot",
      "online": true,
      "offline": false,
      "order": 70
    },
    {
      "component": "healthWorkerBanner",
      "name": "hie-health-worker-banner",
      "slot": "patient-header-slot",
      "online": true,
      "offline": false
    },
    {
      "component": "patientEligibilityBanner",
      "name": "hie-eligibility-banner",
      "slot": "patient-banner-tags-slot",
      "online": true,
      "offline": false
    },
    {
      "component": "healthWorkerBanner",
      "name": "hie-worker-header",
      "slot": "health-worker-hie-header-slot",
      "online": true,
      "offline": false
    },
    {
      "component": "facilityDetailsBanner",
      "name": "hie-facility-header",
      "slot": "facility-hie-header-slot",
      "online": true,
      "offline": false
    }
  ],
  "modals": []
}
